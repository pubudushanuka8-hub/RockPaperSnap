{
   "expo": { 
    "name": "Rock Paper Snap", 
    "slug": "RockPaperSnap", 
    "version": "1.0.0", 
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/appIcon.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dilatha.RockPaperSnap"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/appIcon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor":"#FFFFFF",
          "image":"./assets/images/appIcon.jpg",
          "resizeMode":"contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ec1d1e9b-664c-4554-84cb-224199d312d3"
      }
    }
  }
}